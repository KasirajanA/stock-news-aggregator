{
  "name": "stock-news-aggregator",
  "version": "1.0.0",
  "description": "Stock News Aggregator with live market data",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && python manage.py runserver 0.0.0.0:8000",
    "frontend": "cd frontend && npm start",
    "install-all": "npm install && cd frontend && npm install",
    "build": "cd frontend && npm run build",
    "test": "cd backend && python manage.py test",
    "migrate": "cd backend && python manage.py migrate",
    "makemigrations": "cd backend && python manage.py makemigrations",
    "shell": "cd backend && python manage.py shell",
    "collectstatic": "cd backend && python manage.py collectstatic",
    "superuser": "cd backend && python manage.py createsuperuser"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "stock",
    "news",
    "aggregator",
    "django",
    "react",
    "typescript"
  ],
  "author": "Stock News Aggregator Team",
  "license": "MIT"
} 